# Lead2Meeting Environment Configuration Example
# Copy this file to .env and adjust values as needed. No secrets are required for local use.

L2M_APP_NAME=Lead2Meeting
L2M_ENV=development
L2M_HOST=127.0.0.1
L2M_PORT=8000
L2M_DATABASE_PATH=./lead2meeting.db

# Integration Mode:
# - "simulated": Safe local sandbox mode. All CRM, Calendar, and Email actions are logged locally
#   and explicitly tagged as [SIMULATED]. No external network requests are made.
# - "live": Dispatches real HTTP POST webhooks and SMTP emails when the corresponding URLs/hosts below are set.
L2M_INTEGRATION_MODE=simulated

# SLA Watchdog Thresholds (in hours)
L2M_SLA_NEW_LEAD_HOURS=4.0
L2M_SLA_INVITE_ACCEPTANCE_HOURS=24.0
L2M_SLA_FOLLOWUP_HOURS=48.0
L2M_MAX_RETRY_ATTEMPTS=3

# Optional API Key to protect POST /api/leads webhook ingestion (Header: X-Ingest-Key)
L2M_INGEST_API_KEY=

# Optional Live CRM Webhook Integration (used when L2M_INTEGRATION_MODE=live)
L2M_CRM_WEBHOOK_URL=
L2M_CRM_API_KEY=

# Optional Live Calendar Provisioning Webhook (used when L2M_INTEGRATION_MODE=live)
L2M_CALENDAR_WEBHOOK_URL=
L2M_SLACK_WEBHOOK_URL=

# Optional Live SMTP Settings for Follow-Up Emails (used when L2M_INTEGRATION_MODE=live)
L2M_SMTP_HOST=
L2M_SMTP_PORT=587
L2M_SMTP_USERNAME=
L2M_SMTP_PASSWORD=
L2M_SMTP_FROM_EMAIL=bookings@example.org
